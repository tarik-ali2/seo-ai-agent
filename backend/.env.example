# ── AI Providers ──────────────────────────────────────────────────────────────
# Gemini is PRIMARY — set this first.
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override default Gemini model (default: gemini-1.5-flash)
# Options: gemini-1.5-flash (default), gemini-1.5-pro, gemini-2.0-flash
# GEMINI_MODEL=gemini-1.5-pro

# Anthropic is FALLBACK — used only if Gemini fails or key is not set.
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override default Anthropic model (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Google PageSpeed Insights API ────────────────────────────────────────────
# Optional — 100 req/day without key, 25,000/day with key
# Get key: https://console.cloud.google.com/ → Enable PageSpeed Insights API
PAGESPEED_API_KEY=

# ── App Settings ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-key

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev): sqlite:///./seo_agent.db
# PostgreSQL (prod): postgresql://user:password@host:5432/seo_agent
DATABASE_URL=sqlite:///./seo_agent.db

# ── Google Search Console OAuth ───────────────────────────────────────────────
# Get credentials: https://console.cloud.google.com/
# → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
# → Authorized redirect URIs: http://localhost:8000/api/gsc/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Redirect URI for OAuth callback (must match Google Cloud Console settings)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gsc/auth/callback

# Frontend URL — used to redirect user after OAuth completes
FRONTEND_URL=http://localhost:3000

# ── SEO Tools ─────────────────────────────────────────────────────────────────
# OpenPageRank — Free domain authority scores (100 req/day)
# Get free key at: https://www.openpagerank.com/ → Sign up → API Key
OPR_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
